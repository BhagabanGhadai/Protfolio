---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

// Generate dynamic routes for all posts in the collection
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout title={post.data.title} description={post.data.summary}>
  <div class="container py-12">
    
    <!-- Back Button -->
    <a href="/blog" class="back-link">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
      </svg>
      <span>Back to articles</span>
    </a>

    <!-- Article Header -->
    <header class="article-header py-6">
      <div class="article-meta">
        <span class="meta-date">📅 {post.data.date}</span>
        <span class="meta-sep">·</span>
        <span class="meta-read">⏱ {post.data.readTime}</span>
        <span class="meta-sep">·</span>
        <span class="meta-author">✍ {post.data.author}</span>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      <div class="article-tags">
        {post.data.tags.map(tag => (
          <span class="article-tag">{tag}</span>
        ))}
      </div>
    </header>

    <!-- Cover Image -->
    {post.data.coverImage && (
      <div class="article-cover glass">
        <img src={post.data.coverImage} alt={post.data.title} class="cover-img" />
      </div>
    )}

    <!-- Article Content Grid -->
    <div class="article-content-grid">
      <div class="markdown-body">
        <Content />
      </div>
    </div>

  </div>
</BlogLayout>

<style>
  .py-12 { padding-top: 3rem; padding-bottom: 3rem; }
  .py-6 { padding-top: 1.5rem; padding-bottom: 1.5rem; }

  /* Back Button */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--subtext);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 2rem;
    transition: color 0.2s, transform 0.2s;
  }
  .back-link:hover {
    color: var(--purple);
    transform: translateX(-4px);
  }

  /* Header */
  .article-header {
    margin-bottom: 2rem;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--dim);
    margin-bottom: 12px;
    font-weight: 500;
    flex-wrap: wrap;
  }
  .meta-sep { color: rgba(255,255,255,0.06); }
  .article-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }
  .article-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .article-tag {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sky);
    background: rgba(137, 180, 250, 0.1);
    padding: 3px 10px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Cover Image */
  .article-cover {
    width: 100%;
    height: 400px;
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 3.5rem;
  }
  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Markdown Styling */
  .article-content-grid {
    max-width: 780px;
    margin: 0 auto;
  }
  
  .markdown-body :global(p) {
    font-size: 1.1rem;
    color: var(--subtext);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }
  .markdown-body :global(h2) {
    font-size: 1.65rem;
    font-weight: 700;
    color: #ffffff;
    margin: 2.5rem 0 1rem;
    border-bottom: 1px dashed var(--border);
    padding-bottom: 6px;
  }
  .markdown-body :global(h3) {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin: 2rem 0 1rem;
  }
  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin-left: 24px;
    margin-bottom: 1.5rem;
    color: var(--subtext);
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .markdown-body :global(li) {
    margin-bottom: 6px;
  }
  .markdown-body :global(blockquote) {
    background: rgba(203, 166, 247, 0.05);
    border-left: 4px solid var(--purple);
    padding: 18px 24px;
    margin: 2rem 0;
    border-radius: 8px;
    color: var(--text);
    font-style: italic;
  }
  .markdown-body :global(blockquote p) {
    margin-bottom: 0;
    font-size: 1.05rem;
  }
  .markdown-body :global(code) {
    background: rgba(255, 255, 255, 0.05);
    color: var(--pink);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
  }
  .markdown-body :global(pre) {
    background: rgba(0, 0, 0, 0.25) !important;
    border: 1px solid var(--border);
    border-left: 3px solid var(--purple);
    padding: 20px;
    border-radius: 8px;
    overflow-x: auto;
    margin: 2rem 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.925rem;
    line-height: 1.5;
  }
  .markdown-body :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }
  .markdown-body :global(img) {
    max-width: 100%;
    border-radius: 12px;
    margin: 2rem 0;
    border: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .article-title { font-size: 2.15rem; }
    .article-cover { height: 260px; margin-bottom: 2.5rem; }
    .markdown-body :global(p) { font-size: 1.025rem; }
    .markdown-body :global(pre) { padding: 16px; }
  }
</style>
